	<domains>
		<domain>
			<name>Glory</name>
			<power>You are infused with the glory of the divine, and are a true foe of the undead. In addition, when you channel positive energy to harm undead creatures, the save DC to halve the damage is increased by 2.</power>
		</domain>
			<domain>
			<name>Sun</name>
			<power>You see truth in the pure and burning light of the sun, and can call upon its blessing or wrath to work great deeds.</power>
		</domain>
		<!-- Domains -->
	</domains>
		<!-- Domains -->
	<weapon_proficiencies>Bayonet, Blowgun, Cestus, Club, Heavy Crossbow, Light Crossbow, Dagger, Punching Dagger, Dart, Gauntlet, Spiked Gauntlet, Grapple, Javelin, Longspear, Heavy Mace, Light Mace, Mere Club, Morningstar, Quarterstaff, Rock, Scimitar, Shortspear, Sickle, Sling, Spear, Boar Spear, Ray Spells, Touch Spells, Splash Weapon, Stake, Unarmed Strike</weapon_proficiencies>
	<languages>Celestial, Common</languages>


