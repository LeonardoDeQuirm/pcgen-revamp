						<description>You sense the direction of a well-known or clearly visualized object.</description>
						<bonusspell></bonusspell>
				</spell>
				<spell>
						<name>Lover&#39;s Vengeance</name>
						<outputname>Lover&#39;s Vengeance</outputname>
						<times_memorized>1</times_memorized>
						<range>Touch</range>
						<components>V, M</components>
						<castingtime>1 minute</castingtime>
						<casterlevel>5</casterlevel>
						<concentration>+9</concentration>
						<dc>17</dc>
						<duration>Up to 5 days [D] or until fulfilled</duration>
						<effect>Inspire self or recent lover to vengeful rage against enemy who has wronged you. When in combat with that enemy, gain benefit of rage spell against them for 5 rounds [double if enemy is an ex-lover].</effect>
						<target>Creature touched</target>
						<saveinfo>Will negates (harmless)</saveinfo>
						<school>
							<school>Enchantment</school>
							<subschool>Compulsion</subschool>
							<descriptor>Mind-Affecting</descriptor>
							<fullschool>Enchantment (Compulsion) [Mind-Affecting]</fullschool>
						</school>
						<source>
							<source>Paizo Inc. - Inner Sea World Guide, p.296</source>
							<sourcelevel>Clr3</sourcelevel>
