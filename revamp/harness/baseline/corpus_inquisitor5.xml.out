	<!--
	  ====================================
	  ====================================
			SPECIAL ATTACKS
	  ====================================
	  ====================================-->
	<special_attacks>
		<!-- Visible All "Special Ability" Ability Objects -->
		<special_attack>
			<name>Bane (Su)</name>
			<description>An inquisitor can imbue one of her weapons with the undead-bane weapon special ability as a swift action. This ability lasts for 5 rounds per day. These rounds do not need to be consecutive.</description>
			<type>INQUISITORCLASSFEATURES.SPECIALATTACK.SUPERNATURAL</type>
			<associated></associated>
			<count>0</count>
			<aspect>CheckCount: 5, CheckType: Rounds per Day</aspect>
			<auto>F</auto>
			<hidden>F</hidden>
			<virtual>F</virtual>
			<category>Special Ability</category>
			<source>Paizo Publishing - Advanced Player&#39;s Guide, p.40</source>
		</special_attack>
		<special_attack>
			<name>Hateful Retort (Ex)</name>
			<description>Once per day, as an immediate action after you have been hit with a melee attack, you can make a melee attack against the creature that hit you. This melee attack is at your highest attack bonus, even if you&#39;ve already attacked in the round.</description>
			<type>SPECIALATTACK.EXTRAORDINARY</type>
			<associated></associated>
			<count>0</count>
			<aspect></aspect>
