						<school>
							<school>Transmutation</school>
							<subschool></subschool>
							<descriptor></descriptor>
							<fullschool>Transmutation</fullschool>
						</school>
						<source>
							<source>Paizo Inc. - Pathfinder Player Companion: Faiths of Purity, p.29</source>
