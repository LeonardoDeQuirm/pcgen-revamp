		</special_quality>
			<name>Elven Immunities</name>
			<description>Elves are immune to magic sleep effects and get a +2 racial saving throw bonus against enchantment spells and effects.</description>
			<type>RACIALTRAITS.ELF RACIAL TRAIT.ELF RACIAL DEFAULT.SPECIALQUALITY</type>
