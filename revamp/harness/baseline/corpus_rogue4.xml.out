				<islight>TRUE</islight>
				<sequence>1</sequence>
			</common>
			<melee>
				<invalidtext>
					<tohit>N/A</tohit>
					<damage>N/A</damage>
				</invalidtext>
				<hand>Off-hand</hand>
				<w1_h1_p>
					<!-- One weapon, 1 hand, primary hand -->
					<to_hit>+3</to_hit>
					<damage>1d4</damage>
				</w1_h1_p>
				<w1_h1_o>
					<!-- One weapon, 1 handed, offhand -->
					<to_hit>-1</to_hit>
					<damage>1d4</damage>
				</w1_h1_o>
				<w1_h2>
					<!-- One weapon, 2 handed -->
					<to_hit>+3</to_hit>
					<damage>1d4</damage>
				</w1_h2>
				<w2_p_oh>
					<!-- Two weapons, this weapon in primary hand, other hand with heavy weapon -->
					<to_hit>-3</to_hit>
					<damage>1d4</damage>
				</w2_p_oh>
				<w2_p_ol>
					<!-- Two weapons, this weapon in primary hand, other hand with light weapon -->
					<to_hit>-1</to_hit>
					<damage>1d4</damage>
				</w2_p_ol>
				<w2_o>
					<!-- Two weapons, this weapon in off-hand -->
					<to_hit>-5</to_hit>
					<damage>1d4</damage>
				</w2_o>
			</melee>
	<!-- End New Ranges Section -->

			<ranges>
