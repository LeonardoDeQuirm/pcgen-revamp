				<spell>
						<name>Fear the Sun</name>
						<outputname>Fear the Sun</outputname>
						<times_memorized>1</times_memorized>
						<range>Medium (140 ft.)</range>
						<components>V,S,M</components>
						<castingtime>1 standard action</castingtime>
						<casterlevel>4</casterlevel>
						<concentration>+8</concentration>
						<dc>16</dc>
						<duration>4 rounds</duration>
						<effect>Each target that fails its saving throw gains light blindness, as per the universal monster rule. When exposed to bright light, affected targets are blinded for 1 full round and are dazzled in successive rounds. If you cast this spell in the presence of bright light, any target that fails its save is blinded immediately, and dazzled starting at the beginning of its first turn.</effect>
						<target>Up to 4 creatures, no two of which can be more than 30 ft. apart</target>
						<saveinfo>Fortitude negates</saveinfo>
						<school>
							<school>Transmutation</school>
							<subschool></subschool>
							<descriptor></descriptor>
							<fullschool>Transmutation</fullschool>
						</school>
