			<name>Tail Slap</name>
			<description>The dragon can slap one foe each round with its tail. A tail slap is a secondary attack that deals the indicated damage plus 1-1/2 times the dragon's Strength bonus (this is an exception to the normal secondary attack rules).</description>
			<type>RACEABILITY.SPECIALQUALITY</type>
			<associated></associated>
			<count>0</count>
			<aspect></aspect>
