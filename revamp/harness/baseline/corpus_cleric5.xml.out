						<times_memorized>1</times_memorized>
						<range>Medium (150 ft.)</range>
						<components>V,S</components>
						<castingtime>1 standard action</castingtime>
						<casterlevel>5</casterlevel>
						<concentration>+9</concentration>
						<dc></dc>
						<duration>5 minutes [D]</duration>
						<effect>An immobile curtain of illumination springs into existence. When created, one side of the wall [designated by you] radiates bright light to a range of 60 feet away from that side while the other side radiates darkness to an equal distance. This effect alters the illumination level by up to two steps toward either bright light [the light side] or darkness [the dark side]. The wall also obstructs vision through it, regardless of which side of the wall the viewer is on.</effect>
						<target>10-ft.-high vertical sheet of illumination up to 25 ft. long</target>
						<saveinfo>None</saveinfo>
						<school>
							<school>Evocation</school>
							<subschool></subschool>
							<descriptor>Darkness, Light</descriptor>
							<fullschool>Evocation [Darkness, Light]</fullschool>
						</school>
						<source>
							<source>Paizo Inc. - Pathfinder Player Companion: Blood of Shadows, p.29</source>
							<sourcelevel>Clr3</sourcelevel>
							<sourcelink></sourcelink>
							<sourcepage>p.29</sourcepage>
							<sourceshort>BOS</sourceshort>
						</source>
						<spell_resistance>No</spell_resistance>
						<description>An immobile curtain of illumination springs into existence. When created, one side of the wall (designated by you) radiates bright light to a range of 60 feet away from that side while the other side radiates darkness to an equal distance. This effect alters the illumination level by up to two steps toward either bright light (the light side) or darkness (the dark side). The wall also obstructs vision through it, regardless of which side of the wall the viewer is on.</description>
						<bonusspell></bonusspell>
				</spell>
