		<lift_over_head>300</lift_over_head>
		<lift_off_ground>600</lift_off_ground>
		<!-- And loses Dex bonus to AC and can only move 5 feet per round as a full-round action -->
		<push_drag>1500</push_drag>
	</weight_allowance>
