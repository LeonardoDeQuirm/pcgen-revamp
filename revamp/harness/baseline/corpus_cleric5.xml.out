							<sourcepage>p.296</sourcepage>
							<sourceshort>ISWG</sourceshort>
						</source>
						<spell_resistance>Yes (harmless)</spell_resistance>
						<description>Inspire self or recent lover to vengeful rage against enemy who has wronged you. When in combat with that enemy, gain benefit of rage spell against them for (CASTERLEVEL) rounds [double if enemy is an ex-lover].</description>
						<bonusspell></bonusspell>
				</spell>
