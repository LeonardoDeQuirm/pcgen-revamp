				<spell>
						<name>Hydrophobia</name>
						<outputname>Hydrophobia</outputname>
						<times_memorized>1</times_memorized>
						<range>Close (35 ft.)</range>
						<components>V,S</components>
						<castingtime>1 standard action</castingtime>
						<casterlevel>5</casterlevel>
						<concentration>+9</concentration>
						<dc>17</dc>
						<duration>5 rounds</duration>
						<effect>Targets in the area must succeed at a Will save or become deathly afraid of drowning. If the target is swimming or submerged in water, it must attempt to escape from the water. As long as an affected target remains in water, it takes 1d6 points of nonlethal damage each round. Even out of water, targets cannot imbibe potions or willingly interact with any fluids for the duration of this spell.</effect>
						<target>One living creature</target>
						<saveinfo>Will negates</saveinfo>
						<school>
							<school>Necromancy</school>
							<subschool></subschool>
							<descriptor>Emotion,Fear,Mind-Affecting</descriptor>
							<fullschool>Necromancy [Emotion,Fear,Mind-Affecting]</fullschool>
						</school>
						<source>
							<source>Paizo Inc. - Pathfinder Player Companion: Magical Marketplace, p.8</source>
							<sourcelevel>Clr3</sourcelevel>
							<sourcelink></sourcelink>
							<sourcepage>p.8</sourcepage>
							<sourceshort>MM</sourceshort>
						</source>
						<spell_resistance>Yes</spell_resistance>
						<description>Targets in the area must succeed at a Will save or become deathly afraid of drowning. If the target is swimming or submerged in water, it must attempt to escape from the water. As long as an affected target remains in water, it takes 1d6 points of nonlethal damage each round. Even out of water, targets cannot imbibe potions or willingly interact with any fluids for the duration of this spell.</description>
						<bonusspell></bonusspell>
				</spell>
