	<special_qualities>
		<!-- Visible All "Special Ability" Ability Objects -->
		<special_quality>
			<name>Armor Training (Ex)</name>
			<description>You are more maneuverable while wearing armor. Whenever you are wearing armor, you reduce the armor check penalty by 1 and increase the maximum Dexterity bonus allowed by your armor by +1</description>
			<type>FIGHTERCLASSFEATURES.SPECIALQUALITY.EXTRAORDINARY</type>
			<associated></associated>
			<count>0</count>
			<aspect></aspect>
			<auto>F</auto>
			<hidden>F</hidden>
			<virtual>F</virtual>
			<category>Special Ability</category>
			<source>Paizo Inc. - Core Rulebook, p.55</source>
		</special_quality>
		<special_quality>
			<name>Bonus Feats</name>
			<description>At 1st level, and at every even level thereafter, a fighter gains a bonus feat in addition to those gained from normal advancement (meaning that the fighter gains a feat at every level). These bonus feats must be selected from those listed as combat feats, sometimes also called &quot;fighter bonus feats.&quot; Upon reaching 4th level, and every four levels thereafter (8th, 12th, and so on), a fighter can choose to learn a new bonus feat in place of a bonus feat he has already learned. In effect, the fighter loses the bonus feat in exchange for the new one. The old feat cannot be one that was used as a prerequisite for another feat, prestige class, or other ability. A fighter can only change one feat at any given level and must choose whether or not to swap the feat at the time he gains a new bonus feat for the level.</description>
			<type>FIGHTERCLASSFEATURES.SPECIALQUALITY</type>
			<associated></associated>
			<count>0</count>
			<aspect></aspect>
			<auto>F</auto>
			<hidden>F</hidden>
			<virtual>F</virtual>
			<category>Special Ability</category>
			<source>Paizo Inc. - Core Rulebook</source>
		</special_quality>
		<special_quality>
			<name>Bravery (Ex)</name>
			<description>You gain a +2 bonus to Will saves against fear effects.</description>
			<type>FIGHTERCLASSFEATURES.SPECIALQUALITY.EXTRAORDINARY.BRAVERY</type>
			<associated></associated>
			<count>0</count>
			<aspect>SaveBonus: +2 Will vs. fear</aspect>
			<auto>F</auto>
			<hidden>F</hidden>
			<virtual>F</virtual>
			<category>Special Ability</category>
			<source>Paizo Inc. - Core Rulebook, p.55</source>
		</special_quality>
		<special_quality>
			<name>Defensive Training</name>
			<description>Dwarves get a +4 dodge bonus to AC against monsters of the giant subtype.</description>
			<type>RACIALTRAITS.DWARF RACIAL TRAIT.DWARF RACIAL DEFAULT.SPECIALQUALITY.DEFENSIVE.RACIALDEFENSIVETRAINING</type>
			<associated></associated>
			<count>0</count>
			<aspect>Ability Benefit: (+4 dodge bonus to AC vs. giants), CombatBonus: +4 dodge bonus to AC against monsters of the giant subtype.</aspect>
			<auto>F</auto>
			<hidden>F</hidden>
			<virtual>F</virtual>
			<category>Special Ability</category>
			<source>Paizo Inc. - Pathfinder Companion: Dwarves of Golarion, Front Inside Cover</source>
		</special_quality>
		<special_quality>
			<name>Greed</name>
			<description>Dwarves receive a +2 racial bonus on Appraise skill checks made to determine the price of nonmagical goods that contain precious metals or gemstones.</description>
			<type>RACIALTRAITS.DWARF RACIAL TRAIT.DWARF RACIAL DEFAULT.SPECIALQUALITY</type>
			<associated></associated>
			<count>0</count>
			<aspect></aspect>
			<auto>F</auto>
			<hidden>F</hidden>
			<virtual>F</virtual>
			<category>Special Ability</category>
			<source>Paizo Inc. - Pathfinder Companion: Dwarves of Golarion, Front Inside Cover</source>
		</special_quality>
		<special_quality>
			<name>Hardy</name>
			<description>Dwarves receive a +2 racial bonus on saving throws against poison, spells, and spell-like abilities.</description>
			<type>RACIALTRAITS.DWARF RACIAL TRAIT.DWARF RACIAL DEFAULT.SPECIALQUALITY</type>
			<associated></associated>
			<count>0</count>
			<aspect>SaveBonus: +2 racial bonus on saving throws against poison, spells, and spell-like abilities.</aspect>
			<auto>F</auto>
			<hidden>F</hidden>
			<virtual>F</virtual>
			<category>Special Ability</category>
			<source>Paizo Inc. - Pathfinder Companion: Dwarves of Golarion, Front Inside Cover</source>
		</special_quality>
		<special_quality>
			<name>Stability</name>
			<description>Dwarves receive a +4 racial bonus to their Combat Maneuver Defense when resisting a bull rush or trip attempt while standing on the ground.</description>
			<type>RACIALTRAITS.DWARF RACIAL TRAIT.DWARF RACIAL DEFAULT.SPECIALQUALITY</type>
			<associated></associated>
			<count>0</count>
			<aspect>CombatBonus: +4 bonus to their Combat Maneuver Defense when resisting a bull rush or trip attempt while standing on the ground.</aspect>
			<auto>F</auto>
			<hidden>F</hidden>
			<virtual>F</virtual>
			<category>Special Ability</category>
			<source>Paizo Inc. - Pathfinder Companion: Dwarves of Golarion, Front Inside Cover</source>
		</special_quality>
		<special_quality>
			<name>Stonecunning</name>
			<description>Dwarves receive a +2 bonus on Perception checks to potentially notice unusual stonework, such as traps and hidden doors located in stone walls or floors. They receive a check to notice such features whenever they pass within 10 feet of them, whether or not they are actively looking.</description>
			<type>RACIALTRAITS.DWARF RACIAL TRAIT.DWARF RACIAL DEFAULT.SPECIALQUALITY</type>
			<associated></associated>
			<count>0</count>
			<aspect>SkillBonus: +2 bonus on Perception skill checks to notice unusual stonework, such as traps and hidden doors located in stone walls or floors.</aspect>
			<auto>F</auto>
			<hidden>F</hidden>
			<virtual>F</virtual>
			<category>Special Ability</category>
			<source>Paizo Inc. - Pathfinder Companion: Dwarves of Golarion, Front Inside Cover</source>
		</special_quality>
		<special_quality>
			<name>Weapon Familiarity</name>
			<description>Dwarves are proficient with battleaxes, heavy picks, and warhammers, and treat any weapon with the word &quot;dwarven&quot; in its name as a martial weapon.</description>
			<type>RACIALTRAITS.DWARF RACIAL TRAIT.DWARF RACIAL DEFAULT.SPECIALQUALITY.WEAPON FAMILIARITY.RACIALWEAPONFAMILIARITY</type>
			<associated></associated>
			<count>0</count>
			<aspect></aspect>
			<auto>F</auto>
			<hidden>F</hidden>
			<virtual>F</virtual>
			<category>Special Ability</category>
			<source>Paizo Inc. - Pathfinder Companion: Dwarves of Golarion, Front Inside Cover</source>
		</special_quality>
		<special_quality>
			<name>Weapon Training (Ex)</name>
			<description>Attacks with a weapon from listed groups, gain a bonus on attack and damage rolls. (Included in weapon blocks) Axes +1</description>
			<type>FIGHTERCLASSFEATURES.SPECIALQUALITY.EXTRAORDINARY</type>
			<associated></associated>
			<count>0</count>
			<aspect></aspect>
			<auto>F</auto>
			<hidden>F</hidden>
			<virtual>F</virtual>
			<category>Special Ability</category>
			<source>Paizo Inc. - Core Rulebook, p.56</source>
		</special_quality>
	</special_qualities>
