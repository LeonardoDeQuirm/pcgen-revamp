			<virtual>F</virtual>
			<category>Special Ability</category>
			<source>Paizo Inc. - Advanced Race Guide, p.40</source>
		</special_quality>
		<special_quality>
			<name>Multitalented</name>
			<description>Half-elves choose two favored classes at first level and gain +1 hit point or +1 skill point whenever they take a level in either one of those classes.</description>
			<type>RACIALTRAITS.HALF-ELF RACIAL TRAIT.HALF-ELF RACIAL DEFAULT.SPECIALQUALITY</type>
