		</special_quality>
		<special_quality>
			<name>Defensive Training</name>
			<description>Dwarves get a +4 dodge bonus to AC against monsters of the giant subtype.</description>
			<type>RACIALTRAITS.DWARF RACIAL TRAIT.DWARF RACIAL DEFAULT.SPECIALQUALITY.DEFENSIVE.RACIALDEFENSIVETRAINING</type>
			<associated></associated>
			<count>0</count>
