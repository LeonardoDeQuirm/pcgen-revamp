	<traits>
		<trait>
			<name>Absalom Bouncer</name>
			<description>When you make an attack that deals nonlethal damage with an unarmed strike, you gain a +1 bonus on your damage roll.</description>
			<source>Paizo Inc. - Pathfinder Player Companion: Advanced Class Origins, p.11</source>
		</trait>
		<trait>
			<name>Acadamae Neophyte</name>
			<description>Whenever you succeed at a Knowledge (planes) check to identify a creature and its special powers or vulnerabilities, you gain one additional piece of useful information (as if your skill check result had been 5 higher).</description>
			<source>Paizo Publishing - Pathfinder Player Companion: Monster Summoner&#39;s Handbook, p.10</source>
		</trait>
	</traits>

