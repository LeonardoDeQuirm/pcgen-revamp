		</special_attack>
		<special_attack>
			<name>Judgment / Healing</name>
			<description>The inquisitor is surrounded by a healing light, gaining fast healing 2. This causes the inquisitor to heal 2 point of damage each round as long as the inquisitor is alive and the judgment lasts.</description>
			<type>INQUISITORCLASSFEATURES.INQUISITORJUDGMENTNEITHER.SPECIALATTACK</type>
