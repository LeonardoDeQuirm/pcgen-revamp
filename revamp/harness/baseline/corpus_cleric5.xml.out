				<spell>
						<name>Project Weakness</name>
						<outputname>Project Weakness</outputname>
						<times_memorized>1</times_memorized>
						<range>Touch</range>
						<components>V,S</components>
						<castingtime>1 standard action</castingtime>
						<casterlevel>5</casterlevel>
						<concentration>+9</concentration>
						<dc>17</dc>
						<duration>Permanent</duration>
						<effect>You curse the target with the weaknesses of your kind of vampirism. The creature reacts to garlic, mirrors, ringing bells, sunlight, and so on as if it were a vampire of the same type as you. This cannot kill the target; anything that would kill it [such as a lengthy exposure to sunlight if you are a moroi vampire] renders it helpless until the curse or the harmful effect is removed.</effect>
						<target>Living creature touched</target>
						<saveinfo>Will negates</saveinfo>
						<school>
							<school>Necromancy</school>
							<subschool></subschool>
							<descriptor>Evil, Curse</descriptor>
							<fullschool>Necromancy [Evil, Curse]</fullschool>
						</school>
						<source>
							<source>Paizo Inc. - Pathfinder Player Companion: Blood of the Night, p.30</source>
							<sourcelevel>Clr3</sourcelevel>
							<sourcelink></sourcelink>
							<sourcepage>p.30</sourcepage>
							<sourceshort>BOTN</sourceshort>
						</source>
						<spell_resistance>Yes</spell_resistance>
						<description>You curse the target with the weaknesses of your kind of vampirism. The creature reacts to garlic, mirrors, ringing bells, sunlight, and so on as if it were a vampire of the same type as you. This cannot kill the target; anything that would kill it (such as a lengthy exposure to sunlight if you are a moroi vampire) renders it helpless until the curse or the harmful effect is removed.</description>
						<bonusspell></bonusspell>
				</spell>
