				<spell>
						<name>Carrion Compass</name>
						<outputname>Carrion Compass</outputname>
						<times_memorized>1</times_memorized>
						<range>Close (35 ft.)</range>
						<components>V,S</components>
						<castingtime>1 standard action</castingtime>
						<casterlevel>5</casterlevel>
						<concentration>+9</concentration>
						<dc>15</dc>
						<duration>50 minutes</duration>
						<effect>You animate one of the target&#39;s fetid organs so that it leads you to the undead creature&#39;s most recent controller or the cause of the creature&#39;s undeath. The organ floats in front of you at chest level and slowly leads you to the undead creature&#39;s most recent controller [if none, creator, or, failing that, place of creation] at a rate of 30 feet per round, always staying within your range of vision. If the creature was self&#173;created, or if the it&#39;s most recent controller no longer exists, the spell fails. Once the organ is within 10 feet of its intended destination, the spell ends, and the organ falls to the ground. If the undead creature to which the organ belonged is destroyed, the spell ends and the organ falls to the ground.</effect>
						<target>One undead creature</target>
						<saveinfo>Will negates</saveinfo>
						<school>
							<school>Divination</school>
							<subschool></subschool>
							<descriptor></descriptor>
							<fullschool>Divination</fullschool>
						</school>
						<source>
							<source>Paizo Inc. - Pathfinder Player Companion: Undead Slayer&#39;s Handbook, p.26</source>
							<sourcelevel>Clr1</sourcelevel>
							<sourcelink></sourcelink>
							<sourcepage>p.26</sourcepage>
							<sourceshort>USH</sourceshort>
						</source>
						<spell_resistance>No</spell_resistance>
						<description>You animate one of the target&#39;s fetid organs so that it leads you to the undead creature&#39;s most recent controller or the cause of the creature&#39;s undeath. The organ floats in front of you at chest level and slowly leads you to the undead creature&#39;s most recent controller (if none, creator, or, failing that, place of creation) at a rate of 30 feet per round, always staying within your range of vision. If the creature was self&#173;created, or if the it&#39;s most recent controller no longer exists, the spell fails. Once the organ is within 10 feet of its intended destination, the spell ends, and the organ falls to the ground. If the undead creature to which the organ belonged is destroyed, the spell ends and the organ falls to the ground.</description>
						<bonusspell></bonusspell>
				</spell>
