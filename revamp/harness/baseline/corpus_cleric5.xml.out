			<source>Paizo Inc. - Advanced Race Guide, p.40</source>
		</special_quality>
		<special_quality>
			<name>Low-Light Vision</name>
			<description>Half-elves can see twice as far as humans in conditions of dim light.</description>
			<type>RACIALTRAITS.HALF-ELF RACIAL TRAIT.HALF-ELF RACIAL DEFAULT.SPECIALQUALITY.RACIAL VISION</type>
			<associated></associated>
			<count>0</count>
