		<special_quality>
			<name>Adaptability</name>
			<description>Half-elves receive Skill Focus as a bonus feat at 1st level.</description>
			<type>RACIALTRAITS.HALF-ELF RACIAL TRAIT.HALF-ELF RACIAL DEFAULT.SPECIALQUALITY</type>
			<associated></associated>
			<count>0</count>
