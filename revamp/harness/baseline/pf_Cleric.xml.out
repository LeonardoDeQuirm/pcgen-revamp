	<special_qualities>
		<!-- Visible All "Special Ability" Ability Objects -->
		<special_quality>
			<name>Aura (Ex)</name>
			<description>A cleric of a chaotic, evil, good, or lawful deity has a particularly powerful aura corresponding to the deity&#39;s alignment (see the detect evil spell for details).</description>
			<type>EXTRAORDINARY.CLASSFEATURES.CLERICCLASSFEATURES.SPECIALQUALITY</type>
			<associated></associated>
			<count>0</count>
			<aspect></aspect>
			<auto>F</auto>
			<hidden>F</hidden>
			<virtual>F</virtual>
			<category>Special Ability</category>
			<source>Paizo Inc. - Core Rulebook, p.</source>
		</special_quality>
		<special_quality>
			<name>Aura of Good (Ex)</name>
			<description>You project a moderate good aura.</description>
			<type>SPECIALQUALITY.EXTRAORDINARY.AURA.CLERICCLASSFEATURES.PALADINCLASSFEATURES</type>
			<associated></associated>
			<count>0</count>
			<aspect></aspect>
			<auto>F</auto>
			<hidden>F</hidden>
			<virtual>F</virtual>
			<category>Special Ability</category>
			<source>Paizo Inc. - Core Rulebook</source>
		</special_quality>
		<special_quality>
			<name>Bonus Feat</name>
			<description>Humans select one extra feat at 1st level.</description>
			<type>RACIALTRAITS.HUMAN RACIAL TRAIT.HUMAN RACIAL DEFAULT.SPECIALQUALITY</type>
			<associated></associated>
			<count>0</count>
			<aspect></aspect>
			<auto>F</auto>
			<hidden>F</hidden>
			<virtual>F</virtual>
			<category>Special Ability</category>
			<source>Paizo Inc. - Core Rulebook, p.27</source>
		</special_quality>
		<special_quality>
			<name>Bonus Hit Point</name>
			<description></description>
			<type>FAVOREDCLASSBONUS.SPECIALQUALITY</type>
			<associated></associated>
			<count>1</count>
			<aspect></aspect>
			<auto>F</auto>
			<hidden>F</hidden>
			<virtual>F</virtual>
			<category>Special Ability</category>
			<source>Paizo Inc. - Core Rulebook</source>
		</special_quality>
		<special_quality>
			<name>Bonus Skill Rank (Knowledge (Planes), Knowledge (Religion))</name>
			<description></description>
			<type>FAVOREDCLASSBONUS.SPECIALQUALITY</type>
			<associated>Knowledge (Planes),Knowledge (Religion)</associated>
			<count>2</count>
			<aspect></aspect>
			<auto>F</auto>
			<hidden>F</hidden>
			<virtual>F</virtual>
			<category>Special Ability</category>
			<source>Paizo Inc. - Core Rulebook</source>
		</special_quality>
		<special_quality>
			<name>Orisons</name>
			<description>You can prepare a number of orisons, or 0-level spells. These spells are cast like any other spells, but they are not expended when used and may be used again.</description>
			<type>CLERICCLASSFEATURES.SPECIALQUALITY</type>
			<associated></associated>
			<count>0</count>
			<aspect></aspect>
			<auto>F</auto>
			<hidden>F</hidden>
			<virtual>F</virtual>
			<category>Special Ability</category>
			<source>Paizo Inc. - Core Rulebook, p.41</source>
		</special_quality>
		<special_quality>
			<name>Skilled</name>
			<description>Humans gain an additional skill rank at 1st level and one additional rank whenever they gain a level.</description>
			<type>RACIALTRAITS.HUMAN RACIAL TRAIT.HUMAN RACIAL DEFAULT.SPECIALQUALITY</type>
			<associated></associated>
			<count>0</count>
			<aspect></aspect>
			<auto>F</auto>
			<hidden>F</hidden>
			<virtual>F</virtual>
			<category>Special Ability</category>
			<source>Paizo Inc. - Core Rulebook, p.27</source>
		</special_quality>
		<special_quality>
			<name>Spontaneous Casting</name>
			<description>You can channel stored spell energy into healing spells that you did not prepare ahead of time. You can &quot;lose&quot; any prepared spell that is not an orison or domain spell in order to cast any cure spell of the same spell level or lower (a cure spell is any spell with &quot;Cure&quot; in its name).</description>
			<type>CLERICCLASSFEATURES.SPECIALQUALITY</type>
			<associated></associated>
			<count>0</count>
			<aspect></aspect>
			<auto>F</auto>
			<hidden>F</hidden>
			<virtual>F</virtual>
			<category>Special Ability</category>
			<source>Paizo Inc. - Core Rulebook, p.41</source>
		</special_quality>
		<special_quality>
			<name>Touch of Glory (Sp)</name>
			<description>You can cause your hand to shimmer with divine radiance, allowing you to touch a creature as a standard action and give it a +3 bonus to a single Charisma-based skill check or Charisma ability check. This ability lasts for one hour or until the creature touched elects to apply the bonus to a roll. You can use this ability to grant the bonus 7 times per day.</description>
			<type>CLERICCLASSFEATURES.SPECIALQUALITY.SPELLLIKE.DOMAINPOWER.GLORY DOMAIN</type>
			<associated></associated>
			<count>0</count>
			<aspect>Ability Benefit: (7/day), CheckCount: 7, CheckType: Uses per Day</aspect>
			<auto>F</auto>
			<hidden>F</hidden>
			<virtual>F</virtual>
			<category>Special Ability</category>
			<source>Paizo Inc. - Core Rulebook, p.44</source>
		</special_quality>
	</special_qualities>
	<!--
	  ====================================
	  ====================================
			SPECIAL ATTACKS
	  ====================================
	  ====================================-->
	<special_attacks>
		<!-- Visible All "Special Ability" Ability Objects -->
		<special_attack>
			<name>Channel Positive Energy (Su)</name>
			<description>You can unleash a wave of positive energy. You must choose to deal 2d6 points of positive energy damage to undead creatures or to heal living creatures of 2d6 points of damage. Creatures that take damage from channeled energy receive a DC 16 Will save to halve the damage. You can use this ability 6 times per day.</description>
			<type>CLERICCLASSFEATURES.SUPERNATURAL.SPECIALATTACK.CHANNELENERGYSELECTION.CHANNELENERGY.CHANNEL ENERGY.CHANNEL ENERGY POSITIVE.CHANNEL POSITIVE ENERGY</type>
			<associated></associated>
			<count>0</count>
			<aspect>Ability Benefit: (2d6, DC 16, 6/day), CheckCount: 6, CheckType: Uses per day, MasterAbility: Channel Energy</aspect>
			<auto>F</auto>
			<hidden>F</hidden>
			<virtual>F</virtual>
			<category>Special Ability</category>
			<source>Paizo Inc. - Core Rulebook, p.40</source>
		</special_attack>
		<special_attack>
			<name>Sun&#39;s Blessing (Su)</name>
			<description>Whenever you channel positive energy to harm undead creatures, add a +3 bonus to the damage dealt. Undead do not add their channel resistance to their saves when you channel positive energy.</description>
			<type>CLERICCLASSFEATURES.SPECIALATTACK.SUPERNATURAL.DOMAINPOWER.SUN DOMAIN</type>
			<associated></associated>
			<count>0</count>
			<aspect></aspect>
			<auto>F</auto>
			<hidden>F</hidden>
			<virtual>F</virtual>
			<category>Special Ability</category>
			<source>Paizo Inc. - Core Rulebook, p.47</source>
		</special_attack>
