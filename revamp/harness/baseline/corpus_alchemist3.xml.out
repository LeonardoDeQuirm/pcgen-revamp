		<special_attack>
			<name>Throw Anything (Ex)</name>
			<description>You gain the Throw Anything feat as a bonus feat. You add your Intelligence modifier to damage done with splash weapons, including the splash damage if any. This bonus damage is already included in the bomb class feature.</description>
			<type>ALCHEMISTCLASSFEATURES.SPECIALATTACK.EXTRAORDINARY</type>
